# Kopiér til .env og udfyld:   cp .env.example .env
# .env må ALDRIG committes.

# Lang tilfældig nøgle til at signere session-cookies. Generér med:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Login til /admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Port på værten (bindes kun til 127.0.0.1). 8090 er optaget.
HOST_PORT=8091

# true bag HTTPS (produktion). Sæt til false KUN hvis du tester over http://127.0.0.1:8091,
# ellers kan du ikke logge ind (browseren sender ikke cookien over http).
SESSION_COOKIE_SECURE=true

# Antal reverse proxies der sætter X-Forwarded-* (nginx = 1)
PROXY_COUNT=1

# Spillet
ROUND_LENGTH=10
CHOICES=6

# Upload
MAX_UPLOAD_MB=50

# iTunes-kilden (genrer med kilden "iTunes"). Ingen API-nøgler.
# Landekode til iTunes-søgninger — styrer katalog og previews.
ITUNES_COUNTRY=DK
# Hvor mange dage cachede søgninger er "friske", før Forudfyld henter dem igen
CATALOG_CACHE_DAYS=30
# Timeout (sekunder) for kald til iTunes/Deezer
CATALOG_TIMEOUT=10

# Gunicorn
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
